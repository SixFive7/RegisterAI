# LF in history and in the working tree on every OS. This rule stays first.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

*.exe binary
*.dll binary
*.pdb binary
*.png binary
*.ico binary
*.zip binary
